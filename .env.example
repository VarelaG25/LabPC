# Copia este archivo como .env.local y ajusta los valores.

# URL base de LabPC_backend (Node.js + Express). Puerto por defecto: PORT=4000.
VITE_API_BASE_URL=http://localhost:4000/api

# true  -> los servicios responden con datos mock (no necesita el backend).
# false -> los servicios llaman a LabPC_backend mediante axios.
# Aunque sea false, el panel de administrador y el chat siguen en mock hasta que
# el backend implemente GET /admin/stats y Socket.io (ver API_FEATURES en
# src/core/constants/config.ts).
VITE_USE_MOCKS=true

# Tiempo máximo (ms) de espera de una petición HTTP.
VITE_API_TIMEOUT=10000
